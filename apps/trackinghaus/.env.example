# Required: persistent aggregate storage (Vercel Marketplace → Neon)
DATABASE_URL=

# Required: one self-hosted deployment tracks one blog
TRACKINGHAUS_SITE_KEY=my-blog
TRACKINGHAUS_SITE_NAME=My blog
TRACKINGHAUS_ALLOWED_ORIGINS=
TRACKINGHAUS_TIME_ZONE=UTC

# Optional: normally inferred from Vercel
TRACKINGHAUS_DASHBOARD_URL=
TRACKINGHAUS_REPOSITORY_URL=

# Optional: Monday email (Vercel Marketplace → Resend)
RESEND_API_KEY=
TRACKINGHAUS_TO_EMAIL=
TRACKINGHAUS_FROM_EMAIL=
CRON_SECRET=
