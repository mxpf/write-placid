{
  "name": "@mxpf/write-placid-core",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "files": [
    "packages/core/index.mjs",
    "packages/core/site/*.mjs",
    "packages/core/site/*.d.ts",
    "packages/core/studio/studio.css",
    "packages/core/studio/*.ts",
    "packages/core/studio/*.tsx",
    "packages/core/dist"
  ],
  "exports": {
    ".": "./packages/core/index.mjs",
    "./markdown": {
      "types": "./packages/core/site/markdown.d.ts",
      "default": "./packages/core/site/markdown.mjs"
    },
    "./content": {
      "types": "./packages/core/site/content.d.ts",
      "default": "./packages/core/site/content.mjs"
    },
    "./site": {
      "types": "./packages/core/site/site.d.ts",
      "default": "./packages/core/site/site.mjs"
    },
    "./studio/client": {
      "types": "./packages/core/dist/studio/Studio.d.ts",
      "default": "./packages/core/dist/studio/Studio.js"
    },
    "./studio.css": "./packages/core/studio/studio.css",
    "./studio/content": {
      "types": "./packages/core/dist/studio/content.d.ts",
      "default": "./packages/core/dist/studio/content.js"
    },
    "./studio/editorial": {
      "types": "./packages/core/dist/studio/editorial.d.ts",
      "default": "./packages/core/dist/studio/editorial.js"
    },
    "./studio/save-state": {
      "types": "./packages/core/dist/studio/save-state.d.ts",
      "default": "./packages/core/dist/studio/save-state.js"
    },
    "./studio/save-queue": {
      "types": "./packages/core/dist/studio/save-queue.d.ts",
      "default": "./packages/core/dist/studio/save-queue.js"
    },
    "./studio/editor-recovery": {
      "types": "./packages/core/dist/studio/editor-recovery.d.ts",
      "default": "./packages/core/dist/studio/editor-recovery.js"
    },
    "./studio/caption-inline": {
      "types": "./packages/core/dist/studio/caption-inline.d.ts",
      "default": "./packages/core/dist/studio/caption-inline.js"
    },
    "./studio/article-images": {
      "types": "./packages/core/dist/studio/article-images.d.ts",
      "default": "./packages/core/dist/studio/article-images.js"
    },
    "./studio/rich-text": {
      "types": "./packages/core/dist/studio/rich-text.d.ts",
      "default": "./packages/core/dist/studio/rich-text.js"
    },
    "./studio/caption-editor": {
      "types": "./packages/core/dist/studio/CaptionEditor.d.ts",
      "default": "./packages/core/dist/studio/CaptionEditor.js"
    },
    "./studio/github": {
      "types": "./packages/core/dist/studio/github.d.ts",
      "default": "./packages/core/dist/studio/github.js"
    },
    "./studio/kdrive": {
      "types": "./packages/core/dist/studio/kdrive.d.ts",
      "default": "./packages/core/dist/studio/kdrive.js"
    },
    "./studio/images": {
      "types": "./packages/core/dist/studio/image-files.d.ts",
      "default": "./packages/core/dist/studio/image-files.js"
    },
    "./studio/publish-images": {
      "types": "./packages/core/dist/studio/publish-images.d.ts",
      "default": "./packages/core/dist/studio/publish-images.js"
    },
    "./studio/publishing": {
      "types": "./packages/core/dist/studio/editorial-publishing.d.ts",
      "default": "./packages/core/dist/studio/editorial-publishing.js"
    },
    "./studio/migration": {
      "types": "./packages/core/dist/studio/editorial-migration.d.ts",
      "default": "./packages/core/dist/studio/editorial-migration.js"
    },
    "./studio/repository": {
      "types": "./packages/core/dist/studio/editorial-repository.d.ts",
      "default": "./packages/core/dist/studio/editorial-repository.js"
    },
    "./studio/d1": {
      "types": "./packages/core/dist/studio/d1.d.ts",
      "default": "./packages/core/dist/studio/d1.js"
    },
    "./studio/d1-schema": {
      "types": "./packages/core/dist/studio/d1-schema.d.ts",
      "default": "./packages/core/dist/studio/d1-schema.js"
    },
    "./studio/drive": {
      "types": "./packages/core/dist/studio/drive.d.ts",
      "default": "./packages/core/dist/studio/drive.js"
    },
    "./studio/reconciliation": {
      "types": "./packages/core/dist/studio/kdrive-sync.d.ts",
      "default": "./packages/core/dist/studio/kdrive-sync.js"
    },
    "./studio/scheduler": {
      "types": "./packages/core/dist/studio/scheduled.d.ts",
      "default": "./packages/core/dist/studio/scheduled.js"
    },
    "./studio/reorder": {
      "types": "./packages/core/dist/studio/reorder.d.ts",
      "default": "./packages/core/dist/studio/reorder.js"
    },
    "./studio/smart-quotes": {
      "types": "./packages/core/dist/studio/smart-quotes.d.ts",
      "default": "./packages/core/dist/studio/smart-quotes.js"
    }
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1",
    "lucide-react": ">=0.468.0 <1",
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm ci --prefix apps/site && npm ci --prefix apps/studio && npm ci --prefix apps/trackinghaus && npm ci --prefix apps/drafts-mcp",
    "dev:site": "npm run dev --prefix apps/site",
    "dev:studio": "npm run dev --prefix apps/studio",
    "dev:tracking": "npm run dev --prefix apps/trackinghaus",
    "check:config": "node scripts/check-config.mjs",
    "check:site": "npm test --prefix apps/site",
    "check:studio": "npm test --prefix apps/studio",
    "check:tracking": "npm test --prefix apps/trackinghaus",
    "check:mcp": "npm run type-check --prefix apps/drafts-mcp",
    "build:core": "apps/studio/node_modules/.bin/tsc -p packages/core/tsconfig.json",
    "check:core": "npm run build:core && node --test packages/core/tests/*.test.mjs",
    "pack:core": "npm pack --pack-destination artifacts/core",
    "check": "npm run check:core && npm run check:config && npm run check:site && npm run check:studio && npm run check:tracking && npm run check:mcp"
  },
  "description": "The reusable publishing, content identity, rendering, and authoring core for Write Placid installations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxpf/write-placid.git"
  },
  "keywords": ["publishing", "writing", "static-site", "editor"],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mxpf/write-placid/issues"
  },
  "homepage": "https://github.com/mxpf/write-placid#readme"
}
