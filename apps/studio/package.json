{
  "name": "write-placid-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "npm run build && wrangler deploy --config wrangler.cloudflare.jsonc --keep-vars",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.cloudflare.jsonc",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mxpf/write-placid-core": "file:../..",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "1.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@eslint-react/eslint-plugin": "5.30.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "react-server-dom-webpack": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.73.0",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "wrangler": "^4.154.0"
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.5"
    }
  }
}
