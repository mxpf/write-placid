{
  "name": "write-placid-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "npm run build && wrangler deploy --config wrangler.cloudflare.jsonc --keep-vars",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.cloudflare.jsonc",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mxpf/write-placid-core": "file:../..",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
